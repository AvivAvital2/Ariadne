# Keep the build context lean (and out of the image). Source packages
# (cli/, library/, ariadne_mcp/, docgen/, web/, config.py, pyproject.toml,
# uv.lock, spool_content/, scripts/) are intentionally NOT excluded — uv sync
# needs them.
.git
.gitignore
# Dev interpreter pin (3.14) — the image builds on 3.12; keep it out so uv sync
# doesn't try to select/fetch 3.14 (see the Dockerfile's uv notes).
.python-version
.venv
**/.venv
venv
**/__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache

# Secrets never belong in the image (compose injects them at runtime via .env).
.env
.env.*
!.env.example

# Local Ariadne artifacts / generated output (rebuilt at runtime under /data)
.ariadne
**/.ariadne
ariadne_runs/
*.db
docs/
spool-corpus/
*.zip

# Nested/unrelated repos + editor/tooling dirs
Diglett/
userhub/
.claude
.idea
.vscode
.DS_Store

# The compose file itself isn't needed inside the image
compose.yaml
docker-compose.yml
