# Example operational config for the Ariadne Slack bridge.
# Copy to slack_bridge.yaml and point $ARIADNE_SLACK_CONFIG at it.
#
# Holds NO secrets. Tokens/keys come from the environment / secret store:
#   bridge process : CLAUDE_CODE_OAUTH_TOKEN, SLACK_BOT_TOKEN, SLACK_APP_TOKEN
#                    (must NOT have ANTHROPIC_API_KEY — that would make the agent metered)
#   Ariadne subprocess (scoped) : OPENAI_API_KEY, ARIADNE_ANTHROPIC_API_KEY
# See designs/slack-bridge.md ("Secrets handling").

allowed_users: []        # Slack user IDs (U0123…); an allow-listed user may use the bot anywhere, incl. DMs
allowed_channels: []     # Slack channel IDs (C0ENG…); opens the whole channel
# both empty ⇒ deny everyone (fail-closed)
allow_all: false         # org-wide: true ⇒ anyone who can reach the bot may use it (overrides the two lists above)
allowed_orgs: []         # hard org boundary, independent of allow_all: list your workspace team id (T0…)
                         # and/or Enterprise Grid org id (E0…). When set, a request is served only if it
                         # comes from a listed org AND is not an externally-shared (Slack Connect) channel;
                         # all else is silently ignored. Empty ⇒ off. The bridge logs its own team/enterprise
                         # id at startup so you know what to put here.

pool:
  max_size: 50           # max concurrent warm sessions (each holds an Ariadne MCP subprocess)
  idle_ttl_seconds: 480  # evict a thread's session after this much idle time
  turn_timeout_seconds: 240  # hard cap per turn; a "still working" notice posts at the built-in 120s soft point, then the same turn keeps running to here

enable_feedback: false   # opt-in: allow the bot to write ariadne_log_hit/miss (usage_events)

source_descriptions:     # one-liners the agent sees, to route + clarify
  ariadne: 'Documentation library / knowledge engine that generates & serves codebase docs (this repo).'
  projecta: 'First example project — one-line summary of what this source covers.'
  # projectb: '...'

source_aliases:          # colloquial term → canonical source (bridge-only; never sent to Ariadne)
  ariadne: [ariadne, docs, 'knowledge base', kb]
  projecta: [projecta, 'first project', 'project alpha', proja]
  projectb: [projectb, projb]

source_titles:           # friendly display labels for the `/ariadne greet` announcement
  ariadne: 'Ariadne'     # (the Covers list). Absent ⇒ the bare source key is shown.
  projecta: 'Project Alpha (PA)'
