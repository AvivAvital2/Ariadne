+        )
+        docs = [d for d in docs if d.metadata.get('kind') != CATALOG_KIND_FILE_INDEX]
+        if not docs:
+            return 0
+
+        requests: list[EmbeddingBatchRequest] = []
+        doc_groups: list[list] = []
