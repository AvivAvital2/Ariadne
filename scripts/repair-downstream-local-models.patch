+    def _rel_path(source_name: str, abs_file: str) -> str:
+        if source_name not in roots:
+            roots[source_name] = source_root_for(source_name)
+        root = roots[source_name]
+        if root is not None:
+            try:
+                return str(Path(abs_file).relative_to(root))
+            except ValueError:
