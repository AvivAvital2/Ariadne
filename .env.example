# Ariadne container secrets. Copy this file to `.env` (never commit .env) and
# fill in keys for the model pairs you want to offer during onboarding:
#   ANTHROPIC_API_KEY — doc generation (Claude)
#   OPENAI_API_KEY    — embeddings / search
#   DEEPINFRA_API_KEY — hosted Qwen generation and embeddings (no OpenAI key needed)
# compose.yaml reads .env automatically (env_file, optional).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPINFRA_API_KEY=
