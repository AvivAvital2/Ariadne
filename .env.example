# Ariadne environment — copy this file to `.env` and fill in your keys.
# Ariadne auto-loads `.env` from this directory via python-dotenv.
# `.env` is gitignored; this template (`.env.example`) is committed.

# Always required — embeddings run on OpenAI (text-embedding-3-large),
# whichever generation provider you pick.
OPENAI_API_KEY=sk-...

# Required only when generating with Claude (provider: anthropic, or a
# `claude-*` model). Omit it if you generate with OpenAI.
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------------------------
# The Slack bridge (`ariadne-slack`) is configured separately and must NOT
# reuse this file: its process must not carry ANTHROPIC_API_KEY (that would
# make the agent metered — the bridge fails fast at startup). It uses
# SLACK_BOT_TOKEN, SLACK_APP_TOKEN, CLAUDE_CODE_OAUTH_TOKEN, and a scoped
# ARIADNE_ANTHROPIC_API_KEY. See the "Slack Bridge" section in the README.
# -----------------------------------------------------------------------------
